# 실제 값은 server/.env에 설정. VITE_ 접두사를 사용하지 않는다.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=safemap
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 로그인 연동 전, 로컬에서 DB의 지정 사용자를 사용하려면 두 값을 명시적으로 설정.
# 운영 서버에서는 반드시 false. 개발 사용자도 users 테이블에 실제 존재해야 함.
DEV_AUTH_ENABLED=false
DEV_USER_ID=
