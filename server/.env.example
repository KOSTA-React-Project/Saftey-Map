# 실제 값은 server/.env에 설정. VITE_ 접두사를 사용하지 않는다.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# EC2의 API 컨테이너에서는 같은 네트워크의 MySQL 서비스 이름 사용 (로컬은 127.0.0.1)
DB_HOST=db
DB_PORT=3306
DB_NAME=ansim_note
DB_USER=ansim_app
DB_PASSWORD=

# 안심노트 API: 쓰기 요청을 허용할 프론트 주소
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 로그인 연동 전, 로컬에서 DB의 지정 사용자를 사용하려면 두 값을 명시적으로 설정.
# 운영 서버에서는 반드시 false. 개발 사용자도 users 테이블에 실제 존재해야 함.
DEV_AUTH_ENABLED=false
DEV_USER_ID=

# 로그인 쿠키(JWT) 서명 키. 32자 이상 임의 문자열 (예: openssl rand -base64 48)
JWT_SECRET=
# HTTPS로 배포하면 true (true면 HTTPS 연결에서만 로그인 쿠키를 보냄)
COOKIE_SECURE=false
# nginx 같은 프록시 뒤에서 실행하면 프록시 단계 수 (보통 1). 직접 받으면 비워 둠
TRUST_PROXY=

# 생활안전지도 WMS·범례 요청용 키. 브라우저에 전달하지 않음
SAFEMAP_KEY=

# 실제 WMS 픽셀 분석. 검증 전 기본 비활성화. 서버에서만 설정한다.
SAFEMAP_ANALYSIS_ENABLED=false
# 모든 유형의 팔레트·방향·좌표계·이용 조건을 검토한 뒤에만 true
SAFEMAP_ANALYSIS_VERIFIED=false
# 검토한 1~10등급 hex 색상 10개를 쉼표로 구분. 실제 범례와 다르면 분석 거절.
SAFEMAP_ANALYSIS_PALETTE="#ffffb2,#fee88b,#fed165,#fdb751,#fd9b43,#fa7a35,#f45629,#ea3420,#d31a23,#bd0026"
# 확인된 실제 데이터 기준 기간. API 페이지 수정일/조회일로 대신하지 않는다.
SAFEMAP_ANALYSIS_PERIOD=2025
